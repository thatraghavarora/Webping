:root{--color-primary:#16a34a;--color-primary-hover:#15803d;--color-primary-light:#dcfce7;--color-primary-deep:#166534;--color-wa-green:#25d366;--color-wa-green-hover:#1ebd5a;--color-wa-dark:#075e54;--color-wa-teal:#128c7e;--color-navy:#14532d;--color-navy-dark:#052e16;--color-navy-deep:#022c12;--color-bg-page:#f8fafc;--color-card-bg:#fff;--color-text-main:#1e293b;--color-text-muted:#64748b;--color-text-light:#94a3b8;--color-border:#e2e8f0;--color-border-light:#edf2f7;--color-orange:#ff7a59;--color-gold:#f59e0b;--color-hero-bg:linear-gradient(180deg, #f2fbf5 0%, #f7fdf9 45%, #fff 100%);--color-soft-green:#ecfdf5;--font-family:"Poppins", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;--shadow-sm:0 1px 3px #0000000d;--shadow-md:0 4px 16px -2px #0f172a14;--shadow-lg:0 12px 32px -4px #0f172a1f;--shadow-xl:0 20px 48px -8px #0f172a2e;--radius-sm:8px;--radius-md:12px;--radius-lg:20px;--radius-full:9999px;--transition:all .25s cubic-bezier(.16, 1, .3, 1)}*{box-sizing:border-box;margin:0;padding:0}html{font-family:var(--font-family);color:var(--color-text-main);-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;scroll-behavior:auto;text-rendering:optimizelegibility;background-color:#fff;overflow-x:hidden}body{color:var(--color-text-main);padding-top:72px;font-size:15px;line-height:1.6;overflow-x:hidden}::selection{color:var(--color-navy);background:#586aba33}h1,h2,h3,h4,h5,h6{font-family:var(--font-family);color:inherit;letter-spacing:-.02em;overflow-wrap:break-word;word-wrap:break-word;line-height:1.25}h1{letter-spacing:-.03em;font-size:clamp(30px,5vw,50px);font-weight:800}h2{letter-spacing:-.02em;font-size:clamp(24px,3.5vw,36px);font-weight:800}h3{font-size:clamp(18px,2.5vw,22px);font-weight:700}p{color:inherit;overflow-wrap:break-word;word-wrap:break-word;line-height:1.65}a{color:inherit;text-decoration:none}button{cursor:pointer;background:0 0;border:none;font-family:inherit}.container{max-width:1240px;margin:0 auto;padding:0 24px}.site-header{z-index:1000;background:#fff;border-bottom:1px solid #e2e8f0;width:100%;transition:all .25s cubic-bezier(.16,1,.3,1);position:fixed;top:0;left:0;box-shadow:0 1px 4px #0000000a}.site-header.is-scrolled{-webkit-backdrop-filter:blur(16px);background:#fffffffa;border-bottom:1px solid #cbd5e1;box-shadow:0 4px 20px #0f172a14}.header-container{justify-content:space-between;align-items:center;gap:8px;width:100%;max-width:1400px;height:72px;margin:0 auto;padding:0 24px;display:flex}.brand-logo{color:#0f172a;letter-spacing:-.5px;flex-shrink:0;align-items:center;gap:10px;font-size:21px;font-weight:800;display:flex}.logo-badge{color:#fff;background:linear-gradient(135deg,#25d366,#128c7e);border-radius:9px;justify-content:center;align-items:center;width:36px;height:36px;display:flex;box-shadow:0 4px 14px #25d36659}.brand-logo-img{object-fit:contain;flex-shrink:0;width:auto;max-width:48px;height:38px;transition:transform .2s cubic-bezier(.16,1,.3,1);display:block}.brand-logo-text-wrap{text-align:left;flex-direction:column;align-items:flex-start;line-height:1.1;display:flex}.brand-logo-title{color:#0f172a;letter-spacing:-.3px;white-space:nowrap;font-size:19px;font-weight:800}.brand-logo-accent{color:#64748b;font-weight:600}.brand-logo-subtitle{color:#94a3b8;letter-spacing:.08em;text-transform:uppercase;white-space:nowrap;font-size:8.5px;font-weight:600}.btn-workspace-text-full{display:inline}.btn-workspace-text-compact{display:none}.brand-logo:hover .brand-logo-img{transform:scale(1.06)}.drawer-logo-img{object-fit:contain;flex-shrink:0;width:auto;max-width:42px;height:32px;display:block}.nav-menu{white-space:nowrap;flex-wrap:nowrap;flex:1;justify-content:center;align-items:center;gap:2px;height:100%;margin:0 8px;display:flex}.nav-item{align-items:center;height:100%;display:flex;position:relative}.nav-btn{letter-spacing:-.15px;color:#334155;white-space:nowrap;cursor:pointer;background:0 0;border:1px solid #0000;border-radius:8px;align-items:center;gap:4px;padding:7px 10px;font-size:13px;font-weight:600;transition:all .2s cubic-bezier(.16,1,.3,1);display:inline-flex}.nav-btn:hover{color:var(--color-primary);background-color:#f1f5f9}.nav-btn.active{color:var(--color-primary);background-color:#eef2ff;border:1px solid #c7d2fe;font-weight:700}.dropdown-arrow{color:#64748b;opacity:.75;margin-left:1px;transition:transform .25s,color .25s}.nav-btn:hover .dropdown-arrow,.nav-item:hover .dropdown-arrow{color:var(--color-primary);opacity:1;transform:rotate(180deg)}.pricing-badge-pill{color:#b45309;letter-spacing:.2px;background:#fef3c7;border:1px solid #fde68a;border-radius:9999px;margin-left:4px;padding:2px 7px;font-size:10px;font-weight:700;line-height:1.2}.header-actions{flex-shrink:0;align-items:center;gap:10px;display:flex}.lang-selector{color:#334155;cursor:pointer;transition:var(--transition);background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;align-items:center;gap:6px;padding:6px 12px;font-size:12.5px;font-weight:600;display:flex}.lang-selector:hover{color:#0f172a;background:#f1f5f9;border-color:#cbd5e1}.btn-outline-white{color:#0f172a;transition:var(--transition);cursor:pointer;background:#fff;border:1px solid #cbd5e1;border-radius:8px;justify-content:center;align-items:center;padding:7px 16px;font-size:13px;font-weight:600;display:inline-flex}.btn-outline-white:hover{border-color:var(--color-primary);color:var(--color-primary);background:#f8fafc;transform:translateY(-1px)}.btn-workspace{color:#fff;transition:var(--transition);cursor:pointer;background:#16a34a;border-radius:10px;align-items:center;gap:7px;padding:9px 20px;font-size:13.5px;font-weight:700;display:inline-flex;box-shadow:0 4px 14px #16a34a4d}.btn-workspace:hover{background:#15803d;transform:translateY(-1px);box-shadow:0 6px 20px #16a34a66}.btn-login{color:#1e293b;transition:var(--transition);cursor:pointer;background:#fff;border:1.5px solid #e2e8f0;border-radius:10px;justify-content:center;align-items:center;gap:6px;padding:8px 18px;font-size:13.5px;font-weight:600;display:inline-flex}.btn-login:hover{border-color:var(--color-primary);color:var(--color-primary);background:#f0fdf4}.mobile-menu-btn{color:#0f172a;cursor:pointer;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;flex-shrink:0;justify-content:center;align-items:center;width:40px;height:40px;padding:0;transition:all .2s cubic-bezier(.16,1,.3,1);display:none}.mobile-menu-btn:hover{color:var(--color-primary);background:#f1f5f9;border-color:#cbd5e1}.mobile-menu-btn:active{transform:scale(.96)}.mega-dropdown{opacity:0;visibility:hidden;--tx:0px;transform:translate(var(--tx), 8px);z-index:1050;pointer-events:none;white-space:normal;border:1px solid #e2e8f0;border-radius:16px;padding:20px;transition:opacity .22s cubic-bezier(.16,1,.3,1),transform .22s cubic-bezier(.16,1,.3,1),visibility .22s cubic-bezier(.16,1,.3,1);display:grid;position:absolute;top:100%;box-shadow:0 24px 48px -12px #0f172a33,0 0 0 1px #0f172a14;background:#fff!important}.mega-dropdown:before{content:"";background:0 0;height:14px;position:absolute;top:-14px;left:0;right:0}.nav-item:hover .mega-dropdown,.nav-item:focus-within .mega-dropdown,.mega-dropdown.is-open{opacity:1;visibility:visible;transform:translate(var(--tx), 4px);pointer-events:auto}.mega-dropdown-features{--tx:-50%;grid-template-columns:minmax(0,1fr) 260px;gap:16px;width:min(1180px,100vw - 32px);position:fixed;top:72px;left:50%}.mega-dropdown-solutions{--tx:-35%;grid-template-columns:minmax(0,1fr) 210px;gap:16px;width:min(620px,100vw - 32px);left:50%}.mega-dropdown-tools{--tx:-50%;grid-template-columns:minmax(0,1fr) 210px;gap:16px;width:min(760px,100vw - 32px);left:50%}.mega-dropdown-company{--tx:0px;grid-template-columns:minmax(0,1fr) 210px;gap:16px;width:min(620px,100vw - 32px);left:auto;right:0}@media (width<=1260px){.mega-dropdown-features{--tx:-50%;grid-template-columns:minmax(0,1fr) 230px;gap:12px;width:min(960px,100vw - 32px);padding:16px;position:fixed;top:72px;left:50%}.mega-dropdown-solutions{--tx:-45%;grid-templa