border-radius:12px;flex-direction:column;gap:2px;min-width:140px;padding:6px;animation:.15s ease-out dropdownFadeIn;display:flex;position:absolute;top:calc(100% + 8px);right:0;box-shadow:0 16px 36px -4px #0f172a2e,0 0 0 1px #0f172a0f;background:#fff!important}.lang-option-btn{color:#334155;cursor:pointer;background:0 0;border-radius:6px;justify-content:space-between;align-items:center;width:100%;padding:7px 10px;font-size:12.5px;font-weight:500;transition:all .15s;display:flex}.lang-option-btn:hover{color:var(--color-primary);background:#f1f5f9}.lang-option-btn.active{color:var(--color-primary);background:#eef2ff;font-weight:700}@keyframes dropdownFadeIn{0%{opacity:0;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}.header-actions{align-items:center;gap:12px;display:flex}.btn{border-radius:var(--radius-full);transition:var(--transition);cursor:pointer;white-space:nowrap;justify-content:center;align-items:center;gap:8px;padding:9px 18px;font-size:14px;font-weight:600;display:inline-flex}.btn-primary{background-color:var(--color-primary);color:#fff;box-shadow:0 4px 14px #586aba66}.btn-primary:hover{background-color:var(--color-primary-hover);transform:translateY(-1px)}.btn-wa{background-color:var(--color-wa-green);color:#fff;box-shadow:0 4px 16px #25d36666}.btn-wa:hover{background-color:var(--color-wa-green-hover);transform:translateY(-2px);box-shadow:0 6px 20px #25d36680}.hero-section{background:linear-gradient(180deg, var(--color-navy) 0%, var(--color-navy-dark) 60%, var(--color-navy-deep) 100%);color:#fff;padding:64px 0 80px;position:relative;overflow:hidden}.hero-glow{filter:blur(80px);pointer-events:none;background:radial-gradient(circle,#586aba47 0%,#25d3661a 50%,#0000 70%);width:700px;height:450px;position:absolute;top:10%;left:50%;transform:translate(-50%)}.hero-content{text-align:center;z-index:2;max-width:900px;margin:0 auto 48px;position:relative}.hero-eyebrow{border-radius:var(--radius-full);color:#a5b4fc;background:#ffffff14;border:1px solid #ffffff26;align-items:center;gap:8px;margin-bottom:24px;padding:6px 16px;font-size:13px;font-weight:500;display:inline-flex}.hero-eyebrow .pulse-dot{background:var(--color-wa-green);width:8px;height:8px;box-shadow:0 0 10px var(--color-wa-green);border-radius:50%;animation:2s infinite pulse}@keyframes pulse{0%{opacity:.8;transform:scale(.95)}50%{opacity:1;transform:scale(1.15)}to{opacity:.8;transform:scale(.95)}}.hero-title{letter-spacing:-.8px;background:linear-gradient(#fff 0%,#cbd5e1 100%);-webkit-text-fill-color:transparent;-webkit-background-clip:text;margin-bottom:20px;font-size:46px;font-weight:700;line-height:1.2}.hero-desc{color:#cbd5e1;max-width:780px;margin:0 auto 36px;font-size:18px;font-weight:300;line-height:1.6}.hero-ctas{flex-wrap:wrap;justify-content:center;align-items:center;gap:16px;display:flex}.btn-chrome{background-color:var(--color-primary);color:#fff;border-radius:var(--radius-full);transition:var(--transition);align-items:center;gap:10px;padding:14px 28px;font-size:16px;font-weight:600;display:inline-flex;box-shadow:0 8px 24px #586aba73}.btn-chrome:hover{background-color:var(--color-primary-hover);transform:translateY(-2px);box-shadow:0 12px 28px #586aba8c}.btn-explore{color:#fff;border-radius:var(--radius-full);transition:var(--transition);background:#ffffff1a;border:1px solid #fff3;align-items:center;gap:10px;padding:14px 28px;font-size:16px;font-weight:600;display:inline-flex}.btn-explore:hover{background:#ffffff2e;border-color:#fff6;transform:translateY(-2px)}.hero-card-preview{z-index:2;border-radius:var(--radius-lg);background:#0f142b;border:1px solid #ffffff1f;position:relative;overflow:hidden;box-shadow:0 25px 60px -15px #000000b3}.browser-bar{background:#1e264a;border-bottom:1px solid #ffffff14;align-items:center;gap:12px;padding:10px 16px;display:flex}.dot{border-radius:50%;width:10px;height:10px}.dot-red{background:#ef4444}.dot-yellow{background:#f59e0b}.dot-green{background:#10b981}.browser-url{color:#94a3b8;background:#0000004