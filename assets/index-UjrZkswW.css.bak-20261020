 var(--color-border);border-radius:var(--radius-full);background:var(--color-card-bg);color:var(--color-text-main);cursor:pointer;transition:var(--transition);align-items:center;gap:7px;padding:8px 14px;font-family:inherit;font-size:12.5px;font-weight:600;display:inline-flex}.docs-mini-link:hover{background:var(--color-soft-green);color:var(--color-primary-deep);border-color:#16a34a73}.docs-mini-link svg{color:var(--color-primary)}.docs-final-cta-actions{flex-wrap:wrap;justify-content:center;gap:12px;display:flex}.docs-prev-next{grid-template-columns:1fr 1fr;gap:12px;margin-bottom:32px;display:grid}.docs-prevnext-btn{background:var(--color-card-bg);border:1px solid var(--color-border);border-radius:var(--radius-md);cursor:pointer;transition:var(--transition);align-items:center;gap:12px;padding:14px 18px;font-family:inherit;display:flex}.docs-prevnext-btn:hover{box-shadow:var(--shadow-md);border-color:#16a34a73}.docs-prevnext-btn svg{color:var(--color-primary);flex-shrink:0}.docs-prevnext-next{text-align:right;justify-content:flex-end}.docs-prevnext-btn span{text-transform:uppercase;letter-spacing:.06em;color:var(--color-text-light);margin-bottom:2px;font-size:11px;font-weight:600;display:block}.docs-prevnext-btn strong{color:var(--color-text-main);font-size:14px}.docs-section-related{padding:26px 40px}@media (width<=1024px){.docs-topic-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.docs-grid-row{grid-template-columns:1fr!important}.docs-prev-next{grid-template-columns:1fr}.docs-prevnext-btn{text-align:left!important;justify-content:flex-start!important}}@media (width<=640px){.docs-topic-grid{grid-template-columns:1fr}.docs-section-related{padding:24px 16px}.docs-hero-detail{padding:32px 16px 36px}}.docs-flow{border:1px solid var(--color-border);border-left:3px solid var(--color-wa-green);border-radius:var(--radius-md);background:var(--color-bg-page);margin:16px 0 22px;padding:16px 18px}.docs-flow-title{text-transform:uppercase;letter-spacing:.07em;color:var(--color-primary-deep);margin-bottom:12px;font-size:12px;font-weight:700}.docs-steps-flow{margin:0}.docs-flow-step{position:relative;padding-left:34px!important}.docs-flow-step-marker{position:absolute;top:0;left:0}.docs-flow-step:not(:last-child):after{content:"";background:var(--color-border);width:2px;position:absolute;top:26px;bottom:-12px;left:11px}.pricing-section-title{color:#1e293b;margin-bottom:8px;font-size:clamp(21px,4.5vw,28px);font-weight:700}.pricing-section-desc{color:#64748b;padding:0 8px;font-size:15px}@media (width<=768px){.pricing-grid-4{gap:20px}.pricing-card-box{padding:20px 16px}.pricing-card-box .btn,.cta-section .btn{white-space:normal;text-align:center;height:auto;padding:10px 14px}.price-amount{font-size:34px}.pricing-controls{gap:14px;margin-top:20px}.billing-toggle-container{text-align:center;flex-direction:column;gap:8px;padding:10px 16px}.billing-toggle-container .toggle-label{font-size:13px}.save-badge{margin-left:0}.popular-badge{padding:3px 10px;font-size:10px}.pricing-trust-banner{margin-top:24px}}@media (width<=480px){.pricing-grid-4{gap:24px}.pricing-card-box.popular{transform:none}.table-responsive{-webkit-overflow-scrolling:touch}.section-padding{padding:40px 0 60px}}
